<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_reservation_manager_all" model="ir.rule">
        <field name="name">Manager: all reservations</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="groups" eval="[(4, ref('group_hotel_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rule_reservation_frontdesk_all" model="ir.rule">
        <field name="name">Front Desk: all reservations</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="groups" eval="[(4, ref('group_hotel_frontdesk'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_reservation_housekeeper_none" model="ir.rule">
        <field name="name">Housekeeper: no reservation access</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="groups" eval="[(4, ref('group_hotel_housekeeper'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!-- ============ WAITSTAFF — checked-in only, read-only ============ -->
    <record id="rule_reservation_waitstaff_checkedin" model="ir.rule">
        <field name="name">Waitstaff: checked-in reservations only</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="groups" eval="[(4, ref('group_hotel_waitstaff'))]"/>
        <field name="domain_force">[('state', '=', 'checked_in')]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_reservation_customer_own" model="ir.rule">
        <field name="name">Customer: own reservations only</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="groups" eval="[(4, ref('group_hotel_customer'))]"/>
        <field name="domain_force">[('guest_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_feedback_customer_own" model="ir.rule">
        <field name="name">Feedback: customer sees only own</field>
        <field name="model_id" ref="model_hotel_reservation_feedback"/>
        <field name="groups" eval="[(4, ref('group_hotel_customer'))]"/>
        <field name="domain_force">[('guest_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>