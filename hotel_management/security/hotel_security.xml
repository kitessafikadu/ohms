<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_hotel" model="ir.module.category">
        <field name="name">Hotel Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_hotel_housekeeper" model="res.groups">
        <field name="name">Housekeeper</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="comment">Updates room availability, cleanliness and
            maintenance status. Sees housekeeping tasks.</field>
    </record>

    <record id="group_hotel_frontdesk" model="res.groups">
        <field name="name">Front Desk</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="comment">Manages reservations, check-in, check-out.</field>
    </record>

    <record id="group_hotel_waitstaff" model="res.groups">
        <field name="name">Waitstaff</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="comment">Serves food and beverages to checked-in guests.
            Sees only checked-in reservations.</field>
    </record>

    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="comment">Full control: cancel, delete, configure.</field>
    </record>

    <record id="group_hotel_customer" model="res.groups">
        <field name="name">Hotel Customer</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal user. Books directly and sees only
            their own reservations.</field>
    </record>

</odoo>