<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_hotel_reservation" model="ir.sequence">
            <field name="name">Hotel Reservation</field>
            <field name="code">hotel.reservation</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_hotel_room_service_order" model="ir.sequence">
            <field name="name">Hotel Room Service Order</field>
            <field name="code">hotel.room.service.order</field>
            <field name="prefix">RSO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
            <record id="seq_hotel_event" model="ir.sequence">
            <field name="name">Hotel Event</field>
            <field name="code">hotel.event</field>
            <field name="prefix">EVT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>