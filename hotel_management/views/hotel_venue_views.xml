<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_venue_list" model="ir.ui.view">
        <field name="name">hotel.venue.list</field>
        <field name="model">hotel.venue</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="capacity_seated"/>
                <field name="capacity_standing"/>
                <field name="rate_full_day" widget="monetary"/>
                <field name="event_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_venue_form" model="ir.ui.view">
        <field name="name">hotel.venue.form</field>
        <field name="model">hotel.venue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Grand Ballroom"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="capacity_seated"/>
                            <field name="capacity_standing"/>
                        </group>
                    </group>
                    <group string="Rates">
                        <group>
                            <field name="rate_hourly"/>
                            <field name="rate_half_day"/>
                            <field name="rate_full_day"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="setup_minutes"/>
                            <field name="teardown_minutes"/>
                        </group>
                    </group>
                    <group string="Features">
                        <group>
                            <field name="has_av"/>
                            <field name="has_stage"/>
                            <field name="has_dance_floor"/>
                        </group>
                        <group>
                            <field name="has_outdoor_space"/>
                            <field name="has_kitchen"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Events">
                            <field name="event_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="event_date"/>
                                    <field name="customer_name"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_venue" model="ir.actions.act_window">
        <field name="name">Venues</field>
        <field name="res_model">hotel.venue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>