<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="public_booking_form" name="Public Booking Form">
        <t t-call="website.layout">
            <div class="container py-5">
                <h1>Book your stay</h1>

                <div class="alert alert-info" role="alert">
                    You only need to upload a photo of your ID for confirmation. Our front
                    desk will also read the details from the image at check-in.
                </div>

                <t t-if="field_errors.get('__general__')">
                    <div class="alert alert-danger"
                         t-esc="field_errors['__general__']"/>
                </t>
                <t t-if="error">
                    <div class="alert alert-danger" t-esc="error"/>
                </t>

                <form action="/hotel/book/submit" method="post" class="mt-4"
                      id="booking-form" novalidate="novalidate"
                      enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token"
                           t-att-value="request.csrf_token()"/>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Category</label>
                            <select id="category" class="form-select"
                                    required="required">
                                <t t-foreach="categories" t-as="c">
                                    <option t-att-value="c.id" t-esc="c.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Room</label>
                            <select name="room_id" id="room"
                                    class="form-select" required="required">
                                <option value="">Loading…</option>
                            </select>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_room"/>
                            <t t-if="field_errors.get('room_id')">
                                <div class="text-danger small mt-1"
                                     t-esc="field_errors['room_id']"/>
                            </t>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label>Check-in</label>
                            <input type="date" name="check_in_date"
                                   id="check_in_date"
                                   class="form-control" required="required"
                                   t-att-min="min_check_in"/>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_check_in_date"/>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label>Check-out</label>
                            <input type="date" name="check_out_date"
                                   id="check_out_date"
                                   class="form-control" required="required"
                                   t-att-min="min_check_out"/>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_check_out_date"/>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label>Adults</label>
                            <input type="number" name="adults" id="adults"
                                   value="1" min="1" max="10"
                                   class="form-control" required="required"/>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_adults"/>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label>Children</label>
                            <input type="number" name="children" id="children"
                                   value="0" min="0" max="10"
                                   class="form-control"/>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_children"/>
                        </div>
                    </div>

                    <h4 class="mt-4">Guest Information</h4>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label>Full name (as on ID)</label>
                            <input type="text" name="guest_name"
                                   id="guest_name"
                                   class="form-control" required="required"
                                   title="Enter your first and last name, letters only."/>
                            <small class="text-muted">
                                First name and last name, letters only.
                            </small>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_guest_name"/>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Vehicle plate (optional)</label>
                            <input type="text" name="vehicle_plate"
                                   id="vehicle_plate"
                                   class="form-control"/>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label>ID type</label>
                            <select name="guest_id_type" class="form-select">
                                <option value="passport">Passport</option>
                                <option value="national_id">National ID</option>
                                <option value="driver_license">Driver's License</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Upload ID — Front</label>
                            <input type="file" name="guest_id_scan_front"
                                   id="guest_id_scan_front"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,image/*"/>
                            <small class="text-muted">JPG or PNG. Max 5 MB.</small>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_guest_id_scan_front"/>
                            <t t-if="field_errors.get('guest_id_scan_front')">
                                <div class="text-danger small mt-1"
                                     t-esc="field_errors['guest_id_scan_front']"/>
                            </t>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Upload ID — Back</label>
                            <input type="file" name="guest_id_scan_back"
                                   id="guest_id_scan_back"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,image/*"/>
                            <small class="text-muted">JPG or PNG. Max 5 MB.</small>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_guest_id_scan_back"/>
                            <t t-if="field_errors.get('guest_id_scan_back')">
                                <div class="text-danger small mt-1"
                                     t-esc="field_errors['guest_id_scan_back']"/>
                            </t>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Email</label>
                            <input type="email" name="email" id="email"
                                   class="form-control" required="required"
                                   title="Enter a valid email address."/>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_email"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Phone</label>
                            <input type="tel" name="phone" id="phone"
                                   class="form-control" required="required"
                                   title="10 digits (0912345678) or with country code (+251912345678)."/>
                            <small class="text-muted">
                                10 digits (e.g. 0912345678) or with country
                                code (e.g. +251912345678).
                            </small>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_phone"/>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Emergency contact</label>
                            <input type="text" name="emergency_contact_name"
                                   id="emergency_contact_name"
                                   class="form-control"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Emergency phone</label>
                            <input type="tel" name="emergency_contact_phone"
                                   id="emergency_contact_phone"
                                   class="form-control"
                                   title="Optional. Same format as phone."/>
                            <div class="text-danger small mt-1 d-none"
                                 id="error_emergency_contact_phone"/>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Special requests</label>
                        <textarea name="special_requests"
                                  id="special_requests"
                                  class="form-control" rows="3"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Request reservation
                    </button>
                </form>
            </div>

            <script>
                <![CDATA[
                (function () {
                    'use strict';

                    var NAME_RE = /^[A-Za-z][A-Za-z'\-]*(?:\s+[A-Za-z][A-Za-z'\-]*)+$/;
                    var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$/;
                    var PHONE_RE = /^(?:\+?\d{1,4}[\s\-]?)?\d{6,12}$/;

                    function setFieldError(fieldId, message) {
                        var errId = 'error_' + fieldId;
                        var el = document.getElementById(fieldId);
                        var err = document.getElementById(errId);
                        if (el) {
                            if (message) {
                                el.classList.add('is-invalid');
                            } else {
                                el.classList.remove('is-invalid');
                            }
                        }
                        if (err) {
                            if (message) {
                                err.textContent = message;
                                err.classList.remove('d-none');
                            } else {
                                err.textContent = '';
                                err.classList.add('d-none');
                            }
                        }
                    }

                    function clearAllFieldErrors() {
                        var ids = [
                            'guest_name',
                            'email', 'phone', 'emergency_contact_phone',
                            'check_in_date', 'check_out_date',
                            'adults', 'children', 'room',
                            'guest_id_scan_front', 'guest_id_scan_back'
                        ];
                        for (var i = 0; i < ids.length; i++) {
                            setFieldError(ids[i], null);
                        }
                    }

                    function loadRooms(categoryId) {
                        var sel = document.getElementById('room');
                        if (!sel) return;
                        if (!categoryId) {
                            sel.innerHTML = '<option value="">-- select a category first --</option>';
                            return;
                        }
                        sel.innerHTML = '<option value="">Loading\u2026</option>';
                        fetch('/hotel/rooms/' + categoryId)
                            .then(function (r) {
                                if (!r.ok) throw new Error('HTTP ' + r.status);
                                return r.json();
                            })
                            .then(function (rooms) {
                                if (!rooms.length) {
                                    sel.innerHTML = '<option value="">-- no rooms available --</option>';
                                    return;
                                }
                                sel.innerHTML = rooms.map(function (r) {
                                    return '<option value="' + r.id + '">' +
                                           r.name + ' \u2014 ' + r.rate +
                                           '</option>';
                                }).join('');
                            })
                            .catch(function (err) {
                                sel.innerHTML = '<option value="">-- failed to load rooms --</option>';
                                console.error('Room fetch failed:', err);
                            });
                    }

                    function validatePhone(raw, required) {
                        var p = (raw || '').replace(/[\s\-()]+/g, '');
                        if (!p) {
                            return required ? 'Phone number is required.' : null;
                        }
                        if (!PHONE_RE.test(raw)) {
                            return 'Phone format is invalid.';
                        }
                        var digits = p.replace(/[^\d]/g, '');
                        if (p.charAt(0) === '+') {
                            if (digits.length < 9 || digits.length > 15) {
                                return 'Phone with country code must have 9-15 digits.';
                            }
                        } else if (digits.length !== 10 && digits.length !== 13) {
                            return 'Phone must be 10 digits (0912345678) or 13 digits with country code (251912345678).';
                        }
                        return null;
                    }

                    function validateIdFile(inputId) {
                        var inp = document.getElementById(inputId);
                        if (!inp || !inp.files || inp.files.length === 0) {
                            return null;
                        }
                        var f = inp.files[0];
                        var lower = f.name.toLowerCase();
                        var MAX_BYTES = 5 * 1024 * 1024;
                        var ALLOWED_MIME = ['image/jpeg', 'image/png'];
                        var ALLOWED_EXT = ['.jpg', '.jpeg', '.png'];

                        if (f.size === 0) {
                            return 'The file is empty.';
                        }
                        if (f.size > MAX_BYTES) {
                            var mb = (f.size / (1024 * 1024)).toFixed(2);
                            return 'File is ' + mb + ' MB \u2014 the maximum is 5 MB. ' +
                                   'Resize or compress the image and try again.';
                        }
                        var extOk = ALLOWED_EXT.some(function (e) {
                            return lower.endsWith(e);
                        });
                        if (!extOk) {
                            return 'Only JPG and PNG files are accepted.';
                        }
                        if (f.type && ALLOWED_MIME.indexOf(f.type) === -1) {
                            return 'File type "' + f.type + '" is not accepted. ' +
                                   'Please use JPG or PNG.';
                        }
                        return null;
                    }

                    function validateForm() {
                        var errors = {};

                        function get(id) {
                            var el = document.getElementById(id);
                            return el ? el.value.trim() : '';
                        }

                        var name = get('guest_name');
                        if (!name) {
                            errors['guest_name'] = 'Full name is required.';
                        } else if (!NAME_RE.test(name)) {
                            errors['guest_name'] =
                                'Enter your full name (first and last, letters only).';
                        }

                        var email = get('email');
                        if (!email) {
                            errors['email'] = 'Email is required.';
                        } else if (!EMAIL_RE.test(email)) {
                            errors['email'] = 'Enter a valid email address.';
                        }

                        var phoneErr = validatePhone(get('phone'), true);
                        if (phoneErr) errors['phone'] = phoneErr;

                        var emPhone = get('emergency_contact_phone');
                        if (emPhone) {
                            var emErr = validatePhone(emPhone, false);
                            if (emErr) errors['emergency_contact_phone'] = emErr;
                        }

                        var ci = get('check_in_date');
                        var co = get('check_out_date');
                        var todayStr = new Date().toISOString().slice(0, 10);

                        if (!ci) {
                            errors['check_in_date'] = 'Check-in date is required.';
                        } else if (ci < todayStr) {
                            errors['check_in_date'] = 'Check-in cannot be in the past.';
                        }

                        if (!co) {
                            errors['check_out_date'] = 'Check-out date is required.';
                        } else if (ci && co <= ci) {
                            errors['check_out_date'] = 'Check-out must be after check-in.';
                        }

                        var room = document.getElementById('room');
                        if (!room || !room.value) {
                            errors['room'] = 'Please select a room.';
                        }

                        var adults = parseInt(get('adults'), 10);
                        if (isNaN(adults) || adults < 1) {
                            errors['adults'] = 'At least one adult is required.';
                        }

                        var frontErr = validateIdFile('guest_id_scan_front');
                        if (frontErr) errors['guest_id_scan_front'] = frontErr;

                        var backErr = validateIdFile('guest_id_scan_back');
                        if (backErr) errors['guest_id_scan_back'] = backErr;

                        return errors;
                    }

                    function setupBookingForm() {
                        var cat = document.getElementById('category');
                        if (cat) {
                            cat.addEventListener('change', function () {
                                loadRooms(this.value);
                            });
                            if (cat.value) {
                                loadRooms(cat.value);
                            }
                        }

                        var form = document.getElementById('booking-form');
                        if (!form) return;

                        var watched = [
                            'guest_name',
                            'email', 'phone', 'emergency_contact_phone',
                            'check_in_date', 'check_out_date',
                            'adults', 'children', 'room',
                            'guest_id_scan_front', 'guest_id_scan_back'
                        ];
                        for (var i = 0; i < watched.length; i++) {
                            (function (id) {
                                var el = document.getElementById(id);
                                if (!el) return;
                                var evt = (el.tagName === 'SELECT' || el.type === 'file')
                                    ? 'change' : 'input';
                                el.addEventListener(evt, function () {
                                    setFieldError(id, null);
                                });
                            })(watched[i]);
                        }

                        form.addEventListener('submit', function (e) {
                            clearAllFieldErrors();
                            var errors = validateForm();
                            var keys = Object.keys(errors);
                            if (keys.length) {
                                e.preventDefault();
                                e.stopPropagation();
                                keys.forEach(function (k) {
                                    setFieldError(k, errors[k]);
                                });
                                var first = document.getElementById(keys[0]);
                                if (first) {
                                    first.scrollIntoView({
                                        behavior: 'smooth',
                                        block: 'center'
                                    });
                                    first.focus({preventScroll: true});
                                }
                                return false;
                            }
                            return true;
                        });
                    }

                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', setupBookingForm);
                    } else {
                        setupBookingForm();
                    }
                })();
                ]]>
            </script>
        </t>
    </template>

    <template id="public_booking_thanks" name="Public Booking Thanks">
        <t t-call="website.layout">
            <div class="container py-5">

                <div class="text-center mb-5">
                    <h1>Thank you!</h1>
                    <p class="lead">Your booking request has been received.</p>
                    <p>Our front desk will review and confirm shortly.</p>
                </div>

                <t t-if="reservation">
                    <div class="card mx-auto shadow-sm" style="max-width: 640px;">
                        <div class="card-header bg-success text-white">
                            Reservation reference:
                            <b t-esc="reservation.name"/>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Guest</dt>
                                <dd class="col-sm-8" t-esc="reservation.guest_name"/>

                                <dt class="col-sm-4">Room</dt>
                                <dd class="col-sm-8" t-esc="reservation.room_id.name"/>

                                <dt class="col-sm-4">Check-in</dt>
                                <dd class="col-sm-8" t-esc="reservation.check_in_date"/>

                                <dt class="col-sm-4">Check-out</dt>
                                <dd class="col-sm-8" t-esc="reservation.check_out_date"/>

                                <dt class="col-sm-4">Nights</dt>
                                <dd class="col-sm-8" t-esc="reservation.total_nights"/>

                                <dt class="col-sm-4">Adults / Children</dt>
                                <dd class="col-sm-8">
                                    <t t-esc="reservation.adults"/> /
                                    <t t-esc="reservation.children"/>
                                </dd>

                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    <span class="badge text-bg-secondary"
                                        t-esc="reservation.state"/>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </t>

                <div class="text-center mt-4">
                    <a href="/my/reservations" class="btn btn-primary btn-lg">
                        View my reservations
                    </a>
                    <a href="/" class="btn btn-outline-secondary btn-lg">
                        Back to home
                    </a>
                </div>

                <div class="text-center mt-4 text-muted"
                    t-if="partner and partner.email">
                    <p>
                        A confirmation will be sent to
                        <b t-esc="partner.email"/>.
                    </p>
                    <p>
                        To view your bookings online, click
                        <b>View my reservations</b> and log in with that email.
                        If you don't have an account yet, contact the front desk
                        to set up portal access.
                    </p>
                </div>

                <p class="text-center text-muted mt-3"
                t-if="not partner or not partner.email">
                    Save this page or write down your reservation reference.
                    You'll need it at check-in.
                </p>

            </div>
        </t>
    </template>

    <template id="portal_my_reservations" name="My Reservations">
        <t t-call="portal.portal_layout">
            <div class="container">
                <h1>My Reservations</h1>

                <t t-if="not reservations">
                    <p class="text-muted">
                        You have no reservations yet.
                        <a href="/hotel/book">Book a stay</a>.
                    </p>
                </t>

                <table t-if="reservations" class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>Room</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>State</th>
                            <th/>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="reservations" t-as="r">
                            <tr>
                                <td t-esc="r.name"/>
                                <td t-esc="r.room_id.name"/>
                                <td t-esc="r.check_in_date"/>
                                <td t-esc="r.check_out_date"/>
                                <td>
                                    <span class="badge rounded-pill text-bg-secondary"
                                          t-esc="r.state"/>
                                </td>
                                <td>
                                    <a t-att-href="'/my/reservations/%s' % r.id"
                                       class="btn btn-sm btn-primary">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_reservation_detail" name="Reservation Detail">
        <t t-call="portal.portal_layout">
            <div class="container">
                <t t-if="error">
                    <div class="alert alert-danger" t-esc="error"/>
                </t>

                <h1 t-esc="reservation.name"/>
                <p>
                    <b>Room:</b> <t t-esc="reservation.room_id.name"/>
                </p>
                <p>
                    <b>Check-in:</b> <t t-esc="reservation.check_in_date"/>
                    -
                    <b>Check-out:</b> <t t-esc="reservation.check_out_date"/>
                </p>
                <p><b>State:</b> <t t-esc="reservation.state"/></p>

                <h3>Packages included</h3>
                <t t-if="not reservation.package_ids">
                    <p class="text-muted">No packages on this reservation.</p>
                </t>
                <ul>
                    <t t-foreach="reservation.package_ids" t-as="pkg">
                        <li>
                            <b t-esc="pkg.package_id.name"/><br/>
                            <t t-foreach="pkg.entitlement_ids" t-as="ent">
                                <span t-esc="ent.service_id.name"/>
                                - <span t-esc="ent.qty_remaining"/> left<br/>
                            </t>
                        </li>
                    </t>
                </ul>

                <t t-if="reservation.state == 'checked_in'">
                    <h3>Order additional services</h3>
                    <form t-att-action="'/my/reservations/%s/order' % reservation.id"
                          method="post">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Item</label>
                                <select name="service_id" class="form-select">
                                    <t t-foreach="catalogue" t-as="item">
                                        <option t-att-value="item.id"
                                                t-esc="'%s - %s' % (item.name, item.unit_price)"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label>Quantity</label>
                                <input type="number" name="quantity" value="1"
                                       min="1" class="form-control"/>
                            </div>
                            <div class="col-md-3 mb-3 align-self-end">
                                <button type="submit"
                                        class="btn btn-primary">Order</button>
                            </div>
                        </div>
                    </form>
                </t>

                <h3>Leave feedback</h3>
                <form t-att-action="'/my/reservations/%s/feedback' % reservation.id"
                      method="post">
                    <input type="hidden" name="csrf_token"
                           t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label>Rating (1-5)</label>
                        <input type="number" name="rating" min="1" max="5"
                               value="5" class="form-control"/>
                    </div>
                    <div class="mb-3">
                        <label>Comments</label>
                        <textarea name="comments" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        Submit feedback
                    </button>
                </form>
            </div>
        </t>
    </template>

    <template id="portal_my_home_hotel" name="Portal: My Reservations link"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/web/static/img/icons/star.svg'"/>
                <t t-set="title">My Reservations</t>
                <t t-set="url" t-value="'/my/reservations'"/>
                <t t-set="text">View your bookings and order services.</t>
            </t>
        </xpath>
    </template>

</odoo>