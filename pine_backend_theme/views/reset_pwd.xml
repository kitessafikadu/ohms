<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reset_password" inherit_id="auth_signup.reset_password" name="Custom Reset Password Page">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'o_home_menu_background'"/>
                
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
                <t t-set="show_login_info_panel_param" t-value="request.env['ir.config_parameter'].sudo().get_param('pine_backend_theme.login_show_info_panel', 'True')"/>
                <t t-set="show_login_info_panel_param_normalized" t-value="(show_login_info_panel_param or '').strip().lower()"/>
                <t t-set="show_login_info_panel" t-value="show_login_info_panel_param_normalized in ['true', '1', 'yes', 'on']"/>
                <t t-set="login_left_panel_bg_image_url" t-value="('/web/image?model=res.company&amp;field=login_left_panel_bg_image&amp;id=%s' % request.env.company.id) if request.env.company.login_left_panel_bg_image else ''"/>
                <t t-set="white_label_show_powered_by_param" t-value="request.env['ir.config_parameter'].sudo().get_param('white_label.show_powered_by', 'False')"/>
                <t t-set="white_label_show_powered_by" t-value="(white_label_show_powered_by_param or '').strip().lower() in ['true', '1', 'yes', 'on']"/>
                <t t-set="white_label_powered_by_text" t-value="request.env['ir.config_parameter'].sudo().get_param('white_label.powered_by_text', '')"/>
                
                <div class="oe_website_login_container">
                    <div t-attf-class="card flex-row #{'' if show_login_info_panel else 'no-info-panel'}">
                        <!-- Left side info panel -->
                        <div class="login-info-panel" t-if="show_login_info_panel" t-att-style="'--my-theme-login-left-panel-bg-image: url(%s);' % login_left_panel_bg_image_url if login_left_panel_bg_image_url else None">
                            <div class="info-dots dot-top"></div>
                            <div class="info-dots dot-bottom"></div>
                            <p t-esc="request.env.company.motto or ''"/>
                        </div>

                        <!-- Right side form panel -->
                        <div class="login-form-panel">
                            <div class="mobile-logo d-lg-none mb-4 text-center">
                                <img t-if="request.env.company.login_page_logo"
                                     t-attf-src="/web/image?model=res.company&amp;field=login_page_logo&amp;id={{ request.env.company.id }}"
                                     alt="Company logo" style="max-height: 80px;"/>
                                <img t-else="" src="/pine_backend_theme/static/src/img/logo.png" alt="Logo" style="max-height: 80px;"/>
                            </div>
                            <div class="welcome-text">
                                <h1 t-if="not message">Reset Password</h1>
                                <h1 t-if="message">Success</h1>
                                <p t-if="not message">Please enter your credentials to recover your account.</p>
                            </div>

                            <div t-if="message" class="oe_login_form clearfix">
                                <p class="alert alert-success" role="status">
                                    <t t-esc="message"/>
                                </p>
                                <div class="d-grid shadow-sm">
                                    <a href="/web/login" class="btn btn-primary login-btn" role="button">Back to Login</a>
                                </div>
                            </div>

                            <form class="oe_reset_password_form" role="form" method="post" t-if="not message">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <t t-if="token and not invalid_token">
                                    <div class="form-group field-password">
                                        <label for="password">New Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fa fa-lock"></i></span>
                                            <input type="password" name="password" id="password" class="form-control" required="required" t-att-autofocus="'autofocus'"/>
                                        </div>
                                    </div>
                                    <div class="form-group field-confirm_password">
                                        <label for="confirm_password">Confirm New Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fa fa-lock"></i></span>
                                            <input type="password" name="confirm_password" id="confirm_password" class="form-control" required="required"/>
                                        </div>
                                    </div>
                                </t>

                                <t t-if="not token">
                                    <div class="form-group field-login">
                                        <label for="login">Your Email</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fa fa-envelope-o"></i></span>
                                            <input type="text" name="login" t-att-value="login" id="login" class="form-control" autofocus="autofocus" required="required" autocapitalize="off"/>
                                        </div>
                                    </div>
                                </t>

                                <p class="alert alert-danger" t-if="error" role="alert">
                                    <t t-esc="error"/>
                                </p>
                                
                                <input type="hidden" name="redirect" t-att-value="redirect"/>
                                <input type="hidden" name="token" t-att-value="token"/>
                                
                                <div class="clearfix oe_login_buttons d-grid gap-2">
                                    <button type="submit" class="btn btn-primary login-btn">Reset Password</button>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <a t-if="not token" t-attf-href="/web/login?{{ keep_query() }}" class="field-link">Back to Login</a>
                                        <a t-if="invalid_token" href="/web/login" class="field-link">Back to Login</a>
                                    </div>
                                    <div class="o_login_auth"/>
                                </div>
                            </form>

                            <div class="login-footer" t-if="white_label_show_powered_by and white_label_powered_by_text">
                                <div class="bottom-links">
                                    <span class="powered-by" t-esc="white_label_powered_by_text"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="signup" inherit_id="auth_signup.signup" name="Custom Sign Up Page">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'o_home_menu_background'"/>
                
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
                <t t-set="show_login_info_panel_param" t-value="request.env['ir.config_parameter'].sudo().get_param('pine_backend_theme.login_show_info_panel', 'True')"/>
                <t t-set="show_login_info_panel_param_normalized" t-value="(show_login_info_panel_param or '').strip().lower()"/>
                <t t-set="show_login_info_panel" t-value="show_login_info_panel_param_normalized in ['true', '1', 'yes', 'on']"/>
                <t t-set="login_left_panel_bg_image_url" t-value="('/web/image?model=res.company&amp;field=login_left_panel_bg_image&amp;id=%s' % request.env.company.id) if request.env.company.login_left_panel_bg_image else ''"/>
                <t t-set="white_label_show_powered_by_param" t-value="request.env['ir.config_parameter'].sudo().get_param('white_label.show_powered_by', 'False')"/>
                <t t-set="white_label_show_powered_by" t-value="(white_label_show_powered_by_param or '').strip().lower() in ['true', '1', 'yes', 'on']"/>
                <t t-set="white_label_powered_by_text" t-value="request.env['ir.config_parameter'].sudo().get_param('white_label.powered_by_text', '')"/>
                
                <div class="oe_website_login_container">
                    <div t-attf-class="card flex-row #{'' if show_login_info_panel else 'no-info-panel'}">
                        <!-- Left side info panel -->
                        <div class="login-info-panel" t-if="show_login_info_panel" t-att-style="'--my-theme-login-left-panel-bg-image: url(%s);' % login_left_panel_bg_image_url if login_left_panel_bg_image_url else None">
                            <div class="info-dots dot-top"></div>
                            <div class="info-dots dot-bottom"></div>
                            <p t-esc="request.env.company.motto"/>
                        </div>

                        <!-- Right side form panel -->
                        <div class="login-form-panel">
                            <div class="welcome-text">
                                <h1>Create Account</h1>
                                <p>Join us to start managing your resources.</p>
                            </div>

                            <form class="oe_signup_form" role="form" method="post" t-if="not message">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <t t-call="auth_signup.fields">
                                    <t t-set="only_passwords" t-value="bool(token and not invalid_token)"/>
                                </t>

                                <p class="alert alert-danger" t-if="error" role="alert">
                                    <t t-esc="error"/>
                                </p>
                                
                                <input type="hidden" name="redirect" t-att-value="redirect"/>
                                <input type="hidden" name="token" t-att-value="token"/>
                                
                                <div class="text-center oe_login_buttons d-grid gap-2 pt-3">
                                    <button type="submit" class="btn btn-primary login-btn">Sign up</button>
                                    <a t-attf-href="/web/login?{{ keep_query() }}" class="field-link" role="button">Already have an account?</a>
                                    <div class="o_login_auth"/>
                                </div>
                            </form>

                            <div class="login-footer" t-if="white_label_show_powered_by and white_label_powered_by_text">
                                <div class="bottom-links">
                                    <span class="powered-by" t-esc="white_label_powered_by_text"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
