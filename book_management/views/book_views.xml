<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_book_list" model="ir.ui.view">
        <field name="name">book.book.list</field>
        <field name="model">book.book</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state == 'draft'"
                decoration-danger="state == 'unavailable'"
            >
                <field name="name"/>
                <field name="author_id"/>
                <field name="category_id"/>
                <field name="isbn"/>
                <field name="publication_date"/>
                <field name="price"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_book_form" model="ir.ui.view">
        <field name="name">book.book.form</field>
        <field name="model">book.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,available,unavailable"
                    />
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="author_id"/>
                            <field name="category_id"/>
                        </group>

                        <group>
                            <field name="isbn"/>
                            <field name="publication_date"/>
                            <field name="price"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_book_search" model="ir.ui.view">
        <field name="name">book.book.search</field>
        <field name="model">book.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <field name="category_id"/>
                <field name="isbn"/>

                <filter
                    string="Available"
                    name="available"
                    domain="[('state', '=', 'available')]"
                />

                <filter
                    string="Unavailable"
                    name="unavailable"
                    domain="[('state', '=', 'unavailable')]"
                />

                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />

                <group expand="0" string="Group By">
                    <filter
                        string="Author"
                        name="group_by_author"
                        context="{'group_by': 'author_id'}"
                    />

                    <filter
                        string="Category"
                        name="group_by_category"
                        context="{'group_by': 'category_id'}"
                    />

                    <filter
                        string="State"
                        name="group_by_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">book.book</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_book_search"/>
    </record>

</odoo>