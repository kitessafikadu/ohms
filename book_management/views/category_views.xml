<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_category_list" model="ir.ui.view">
        <field name="name">book.category.list</field>
        <field name="model">book.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_category_form" model="ir.ui.view">
        <field name="name">book.category.form</field>
        <field name="model">book.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_category_search" model="ir.ui.view">
        <field name="name">book.category.search</field>
        <field name="model">book.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">book.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_category_search"/>
    </record>

</odoo>